# ═══════════════════════════════════════════
# FIA Engagement Engine (Sofía)
# Copy to .env and fill in real values
# ═══════════════════════════════════════════

# === Supabase (FIA Copilot DB) ===
SUPABASE_URL=https://amqqqqubpsjtdufoinlg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# === Message generation — Claude API (optional: falls back to templates/Codex) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === WhatsApp — Evolution API (default provider) ===
WHATSAPP_PROVIDER=evolution
EVOLUTION_BASE_URL=https://your-evolution-host
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=Sofia
# Timeout (ms) for the /health connectionState poll. Default 6000.
EVOLUTION_STATUS_TIMEOUT_MS=6000
# Optional fallback provider (cloud_api / evolution / empty)
WHATSAPP_FALLBACK_PROVIDER=

# Meta Cloud API (alternative — set WHATSAPP_PROVIDER=cloud_api)
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=fia-engine

# Twilio (alternative — set WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Engine config ===
ENGINE_BASE_URL=https://engine.axeljutoran.com
FIA_APP_BASE_URL=https://fiacopilot.com
ADMIN_API_TOKEN=change-me-to-a-random-token
LOG_LEVEL=info
